{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Astro adapter writes the deploy config (entrypoint and assets directory)
  // into dist/; this file only holds what the adapter does not set.
  "name": "retama-landing",
  "compatibility_date": "2026-10-01",
  // Each branch Preview gets <preview>-retama-landing.<subdomain>.workers.dev.
  // wrangler deploy applies it, so it lives here and not in the dashboard.
  "preview_urls": true,
  "assets": {
    "html_handling": "force-trailing-slash",
    // Serves the nearest 404.html walking up the path: /en/* gets /en/404.html.
    "not_found_handling": "404-page"
  },
  // /api/contact counts sends per visitor IP: 3 a minute (ADR 0002). It is a counter per Cloudflare
  // location, not storage (ADR 0003). The secrets the function needs are set with `wrangler secret put`:
  // TURNSTILE_SECRET_KEY, RESEND_API_KEY, CONTACT_FROM, CONTACT_TO and CONTACT_BACKUP.
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  // Previews do not inherit the production bindings: without their own limiter, /api/contact answers 503.
  // Same limit, but their own counter, so trying a Preview does not spend the sends of the real site.
  // Their secrets are set apart too, with `wrangler preview base-config secret put`.
  "previews": {
    "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }]
  }
}
