{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Astro adapter writes the deploy config (entrypoint and assets directory)
  // into dist/; this file only holds what the adapter does not set.
  "name": "retama-landing",
  "compatibility_date": "2026-10-01",
  // Production lives only on retama.dev: the Custom Domain brings its DNS record and certificate, and the
  // workers.dev URL is off. www.retama.dev is a Redirect Rule of the zone (dashboard), not a route of the Worker.
  "routes": [{ "pattern": "retama.dev", "custom_domain": true }],
  "workers_dev": false,
  // Each branch Preview gets <preview>-retama-landing.<subdomain>.workers.dev, also with workers_dev off.
  // wrangler deploy applies it, so it lives here and not in the dashboard.
  "preview_urls": true,
  // Workers Logs and Traces, every invocation: the free plan keeps 200,000 events a day for 3 days, far above
  // this site's traffic (the contact sends and the uptime check every 5 minutes). Previews log too.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "html_handling": "force-trailing-slash",
    // Serves the nearest 404.html walking up the path: /en/* gets /en/404.html.
    "not_found_handling": "404-page"
  },
  // /api/contact counts sends per visitor IP: 3 a minute (ADR 0002). It is a counter per Cloudflare
  // location, not storage (ADR 0003). The secrets the function needs are set with `wrangler secret put`:
  // TURNSTILE_SECRET_KEY, RESEND_API_KEY, CONTACT_FROM, CONTACT_TO and CONTACT_BACKUP.
  // /api/report counts the client error and CSP reports per visitor IP: 20 a minute, its own counter (ADR 0011).
  // In front of it, a WAF rate limiting rule of the zone, set in the dashboard, stops floods before the Worker.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "REPORT_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Previews do not inherit the production bindings: without their own limiter, /api/contact answers 503.
  // Same limit, but their own counter, so trying a Preview does not spend the sends of the real site.
  // Their secrets are set apart too, with `wrangler preview base-config secret put`.
  "previews": {
    "ratelimits": [
      { "name": "CONTACT_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
      { "name": "REPORT_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
    ]
  }
}
