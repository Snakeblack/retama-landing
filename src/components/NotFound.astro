---
import { type Locale, localizedPath, t } from "../i18n/index";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={`${copy["notFound.title"]} · Retama`} description={copy["notFound.lead"]} noindex>
  <section class="mx-auto max-w-(--spacing-content) px-lg py-2xl">
    <h1 class="mb-md text-5xl leading-[1.1] font-(weight:--font-weight-headline-display) tracking-headline-display">{copy["notFound.title"]}</h1>
    <p class="mb-lg text-body-lg text-neutral">{copy["notFound.lead"]}</p>
    <p><a href={localizedPath(locale, "/")}>{copy["notFound.back"]}</a></p>
  </section>
</Base>
