---
import { type Locale, localizedPath, t } from "../i18n/index";
import Base from "../layouts/Base.astro";
import Footer from "./board/Footer.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={`${copy["notFound.title"]} · Retama`} description={copy["notFound.lead"]} noindex>
  <section class="mt-(--header-height) px-margin pt-xl pb-section">
    <div class="max-w-(--spacing-measure) bg-surface-raised p-tile-sm md:p-tile">
      <h1 class="type-headline-sm mb-lg text-balance md:type-headline">{copy["notFound.title"]}</h1>
      <p class="type-statement-sm mb-xl md:type-statement">{copy["notFound.lead"]}</p>
      <a class="type-label inline-flex min-h-(--spacing-touch) items-center bg-primary px-lg text-on-primary hover:bg-field hover:text-on-field" href={localizedPath(locale, "/")}>{copy["notFound.back"]}</a>
    </div>
  </section>
  <Footer slot="footer" locale={locale} />
</Base>
