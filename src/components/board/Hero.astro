---
import { type Locale, t } from "../../i18n/index";
import Poster from "./Poster.astro";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
const manifesto = [copy["manifesto.line1"], copy["manifesto.line2"]];
---

<!-- DESIGN.md Layout, the first chapter: a stage the height of the screen, pinned while the chapter scrolls under it,
     holds the scene; over it, the title that says what Retama makes with the lead and the action under it (in the
     middle of the left side from lg, at the top on phones), then the manifesto,
     which rises over the roots as the camera goes down them. The text layer lets the pointer through to the scene, but
     for the word, which has its code lens; scene.ts follows the pointer over the whole chapter. -->
<div class="relative grid" data-chapter="hero">
  <div class="sticky top-0 col-start-1 row-start-1 h-svh self-start overflow-hidden" data-scene>
    <Poster label={copy["hero.poster"]} />
    <!-- ADR 0004 and WCAG 2.2.2: a tap or click on the running scene pauses it. scene.ts shows this layer over the
         canvas while the scene runs and swaps its label; it has no visible text, only the focus ring. -->
    <button
      class="absolute inset-0 size-full cursor-pointer"
      type="button"
      aria-label={copy["hero.scenePauseLabel"]}
      data-scene-pause
      data-pause={copy["hero.scenePauseLabel"]}
      data-play={copy["hero.scenePlayLabel"]}
      hidden
    ></button>
  </div>

  <div class="pointer-events-none relative col-start-1 row-start-1 px-margin">
    <div class="grid min-h-svh grid-cols-2 content-start gap-gap lg:grid-cols-12 lg:content-center">
      <h1 class="pointer-events-auto col-span-2 grid p-tile-sm md:p-tile lg:col-span-8">
        <span class="whitespace-nowrap type-display-sm lg:type-display">
          <!-- DESIGN.md Motion: the word is decoded from the site's own code, then the code lens follows the pointer;
               once the scene runs, its glyphs take the word's place. The layer is a copy drawn by CSS from data-text. -->
          <span class="relative inline-block" data-lens data-decode data-glyph-word data-text={copy["hero.word"]}>
            {copy["hero.word"]}
          </span>
        </span>
        {" "}
        <span class="justify-self-start type-headline-sm md:type-headline" data-glyph-word>{copy["hero.rest"]}</span>
      </h1>

      <div class="col-span-2 flex flex-col items-start gap-lg px-tile-sm md:px-tile lg:col-span-5">
        <p class="max-w-(--spacing-measure)">{copy["hero.lead"]}</p>
        <a class="feedback pointer-events-auto flex min-h-(--spacing-touch) items-center bg-primary px-lg type-label text-on-primary hover:bg-field hover:text-on-field" href={`#${copy["anchor.contact"]}`}>
          {copy["hero.action"]}
        </a>
      </div>
    </div>

    <!-- DESIGN.md Motion: the manifesto, two lines that go from muted to full ink word by word as they rise. -->
    <div class="flex min-h-svh flex-col justify-center gap-2xl p-tile-sm md:p-tile">
      {
        manifesto.map((line) => (
          <p class="max-w-(--spacing-measure) text-balance type-headline-sm md:type-headline" data-manifesto>
            {line.split(" ").map((word, index) => (
              <>
                {index > 0 && " "}
                <span class="inline-block" data-word>
                  {word}
                </span>
              </>
            ))}
          </p>
        ))
      }
    </div>
  </div>
</div>
