---
import { type Locale, t } from "../../i18n/index";
import { sheets } from "../../lib/board";
import DecisionSheet from "../DecisionSheet.astro";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
// The figures the method answers for, under its heading; the last one counts up once (DESIGN.md Motion).
const figures = [
  ["services.figure", "services.figureCaption"],
  ["hero.figure2", "hero.figure2Caption"],
  ["hero.figure1", "hero.figure1Caption"],
] as const;
const principles = [
  ["method.d1", "method.d1Reason"],
  ["method.d2", "method.d2Reason"],
  ["method.d3", "method.d3Reason"],
  ["method.d4", "method.d4Reason"],
] as const;
// The live piece and the proof of the method (DESIGN.md Overview): a native exclusive accordion laid out as tabs
// (global.css), so it works without JS. Each project opens the first three decisions Retama would record for it.
const projects = ["web", "custom", "desktop", "agents"] as const;
---

<section id={copy["anchor.method"]} class="grid grid-cols-2 gap-gap lg:grid-cols-12" aria-labelledby="method-title">
  <div class="col-span-2 flex flex-col justify-between gap-xl bg-surface-raised p-tile-sm md:p-tile lg:col-span-6">
    <div class="grid gap-lg">
      <h2 id="method-title" class="text-balance type-headline-sm md:type-headline">{copy["method.title"]}</h2>
      <p class="max-w-(--spacing-measure) type-statement-sm md:type-statement">{copy["method.lead"]}</p>
    </div>
    <dl class="grid gap-md md:grid-cols-3 md:gap-lg">
      {
        figures.map(([figure, caption]) => (
          <div class="flex items-baseline gap-md md:grid md:content-start md:gap-xs">
            <dt class="min-w-(--spacing-2xl) type-headline-sm tabular-nums md:type-headline" data-count={figure === "hero.figure1" ? "" : undefined}>
              {copy[figure]}
            </dt>
            <dd class="type-small text-on-surface-muted">{copy[caption]}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <ul class="col-span-2 grid content-start gap-lg bg-surface-raised p-tile-sm md:grid-cols-2 md:p-tile lg:col-span-6 lg:grid-cols-1 lg:content-between">
    {
      principles.map(([lead, reason]) => (
        <li class="max-w-(--spacing-measure)">
          <strong class="type-body-strong">{copy[lead]}</strong> {copy[reason]}
        </li>
      ))
    }
  </ul>

  <div class="col-span-2 lg:col-span-12" data-projects>
    <div class="grid content-start gap-md bg-surface-raised p-tile-sm md:p-tile">
      <h3 class="text-balance type-statement-sm md:type-statement">{copy["live.title"]}</h3>
      <p>{copy["live.lead"]}</p>
    </div>
    {
      projects.map((sheet, index) => (
        <details class="group" name="project" open={index === 0}>
          <summary class="feedback flex min-h-(--spacing-touch) cursor-pointer list-none items-center gap-md bg-surface-raised p-tile-sm type-statement-sm text-on-surface-muted group-open:bg-field group-open:text-on-field hover:bg-field hover:text-on-field md:p-tile [&::-webkit-details-marker]:hidden">
            <span class="size-sm shrink-0 bg-on-surface-muted group-open:bg-primary" aria-hidden="true" />
            {copy[sheets[sheet][0]]}
          </summary>
          <DecisionSheet locale={Astro.props.locale} sheet={sheet} class="h-full" />
        </details>
      ))
    }
  </div>
</section>
