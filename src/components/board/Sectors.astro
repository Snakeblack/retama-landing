---
import { type Locale, t } from "../../i18n/index";
import ExampleTable from "./ExampleTable.astro";
import PortalFragment from "./PortalFragment.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
// DESIGN.md Imagery: one example fragment per sector. Each row may name the status it moves to while the fragment is
// on screen (DESIGN.md Motion, the sectors switcher); both are in the HTML.
const tables = {
  logistics: {
    caption: copy["frag.routes.caption"],
    columns: [copy["frag.routes.route"], copy["frag.routes.stops"], copy["frag.routes.status"]],
    rows: [
      {
        cells: ["R-12", 14, copy["frag.routes.onRoute"]],
        alert: false,
        next: { text: copy["frag.routes.delivered"], alert: false },
      },
      {
        cells: ["R-07", 9, copy["frag.routes.loading"]],
        alert: false,
        next: { text: copy["frag.routes.onRoute"], alert: false },
      },
      {
        cells: ["R-21", 11, copy["frag.routes.incident"]],
        alert: true,
        next: { text: copy["frag.routes.reassigned"], alert: false },
      },
    ],
  },
  business: {
    caption: copy["frag.approvals.caption"],
    columns: [copy["frag.approvals.request"], copy["frag.approvals.team"], copy["frag.approvals.status"]],
    rows: [
      {
        cells: [copy["frag.approvals.laptops"], copy["frag.approvals.finance"], copy["frag.approvals.pending"]],
        alert: false,
        next: { text: copy["frag.approvals.approved"], alert: false },
      },
      {
        cells: [copy["frag.approvals.supplier"], copy["frag.approvals.legal"], copy["frag.approvals.approved"]],
        alert: false,
        next: { text: copy["frag.approvals.signed"], alert: false },
      },
      {
        cells: [copy["frag.approvals.trip"], copy["frag.approvals.management"], copy["frag.approvals.returned"]],
        alert: true,
        next: { text: copy["frag.approvals.resent"], alert: false },
      },
    ],
  },
  produce: {
    caption: copy["frag.orders.caption"],
    columns: [copy["frag.orders.client"], copy["frag.orders.order"], copy["frag.orders.status"]],
    rows: [
      {
        cells: [copy["frag.orders.greengrocer"], copy["frag.orders.boxes12"], copy["frag.orders.received"]],
        alert: false,
        next: { text: copy["frag.orders.prepared"], alert: false },
      },
      {
        cells: [copy["frag.orders.bar"], copy["frag.orders.boxes8"], copy["frag.orders.preparing"]],
        alert: false,
        next: { text: copy["frag.orders.loaded"], alert: false },
      },
      {
        cells: [copy["frag.orders.restaurant"], copy["frag.orders.tomato"], copy["frag.orders.outOfStock"]],
        alert: true,
        next: { text: copy["frag.orders.substituted"], alert: false },
      },
    ],
  },
} as const;
const sectors = [
  ["sectors.item1", "sectors.item1Problem", ["sectors.item1Build1", "sectors.item1Build2", "sectors.item1Build3"], tables.logistics],
  ["sectors.item2", "sectors.item2Problem", ["sectors.item2Build1", "sectors.item2Build2", "sectors.item2Build3"], tables.business],
  ["sectors.item3", "sectors.item3Problem", ["sectors.item3Build1", "sectors.item3Build2", "sectors.item3Build3"], tables.produce],
  ["sectors.item4", "sectors.item4Problem", ["sectors.item4Build1", "sectors.item4Build2", "sectors.item4Build3"], undefined],
] as const;
---

<section id={copy["anchor.sectors"]} class="grid grid-cols-2 gap-gap lg:grid-cols-12 lg:board-rows" aria-labelledby="sectors-title">
  <div class="col-span-2 bg-surface-raised p-tile-sm md:p-tile lg:col-span-6">
    <h2 id="sectors-title" class="text-balance type-headline-sm md:type-headline">{copy["sectors.title"]}</h2>
  </div>

  <p class="col-span-2 bg-surface-raised p-tile-sm type-statement-sm hyphenate-long md:p-tile md:type-statement lg:col-span-3">
    {copy["sectors.statement"]}
  </p>

  <p class="col-span-2 bg-field p-tile-sm text-on-field type-statement-sm hyphenate-long md:p-tile md:type-statement lg:col-span-3">
    {copy["sectors.field"]}
  </p>

  <!-- DESIGN.md Motion, the sectors switcher: a native exclusive accordion laid out as tabs (global.css), so it
       works without JS; the motion script adds the tour, the wipe and the live fragments. -->
  <div class="col-span-2 lg:col-span-12" data-sectors>
    {
      sectors.map(([name, problem, builds, table], index) => (
        <details class="group" name="sector" open={index === 0}>
          <summary class="feedback flex min-h-(--spacing-touch) cursor-pointer list-none flex-col justify-between gap-md bg-surface-raised p-tile-sm text-on-surface-muted type-statement-sm group-open:text-on-surface hover:bg-field hover:text-on-field md:p-tile lg:type-statement [&::-webkit-details-marker]:hidden">
            {copy[name]}
            <span class="block h-(--spacing-focus) bg-primary" aria-hidden="true" data-sectors-progress />
          </summary>
          <div class="grid grid-cols-1 gap-gap md:grid-cols-2" data-sectors-panel>
            <div class="grid content-start gap-lg bg-surface-raised p-tile-sm md:p-tile">
              <p class="text-balance type-statement-sm md:type-statement">{copy[problem]}</p>
              <div class="grid gap-sm">
                <p class="type-small text-on-surface-muted">{copy["sectors.builds"]}</p>
                <ul class="grid gap-sm">
                  {builds.map((build) => (
                    <li class="flex gap-sm">
                      <span class="mt-sm size-sm shrink-0 bg-primary" aria-hidden="true" />
                      {copy[build]}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            {table ? <ExampleTable locale={locale} {...table} /> : <PortalFragment locale={locale} />}
          </div>
        </details>
      ))
    }
  </div>
</section>
