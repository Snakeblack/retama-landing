---
import { type Locale, t } from "../../i18n/index";
import RetamaDots from "./RetamaDots.astro";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
const services = [
  ["services.web", "services.webLine", "services.webFrom"],
  ["services.custom", "services.customLine", "services.customFrom"],
  ["services.agents", "services.agentsLine", "services.agentsFrom"],
  ["services.seo", "services.seoLine", "services.seoFrom"],
] as const;
// DESIGN.md Imagery: the cards read the hero's retama from the top down, as a dot screen drawn at build time. From lg
// each card frames its own part of the plant (x, y, width and height in the frame of HERO): the crown, its base with
// the taproot, the roots and their tips.
const PARTS = ["560 60 480 470", "600 330 400 390", "380 560 840 820", "100 1100 1400 800"];
// Below lg the cards stack and one plant runs down through them: a column as wide as the crown, cut into slices in
// the 5:2 of their windows, one after the other.
const COLUMN = { x: 500, y: 60, width: 600 };
const slice = (index: number) => {
  const height = (COLUMN.width * 2) / 5;
  return `${COLUMN.x} ${COLUMN.y + index * height} ${COLUMN.width} ${height}`;
};
// The one field card, so the row is not four of the same tile.
const FIELD = 2;
---

<section id={copy["anchor.services"]} class="grid gap-gap" aria-labelledby="services-title">
  <!-- Before any price, one sentence says they are starting prices and the lead times a guide (owner, 2026-10-26). -->
  <div class="grid gap-sm px-tile-sm pt-tile-sm pb-lg md:px-tile md:pt-tile">
    <h2 id="services-title" class="text-balance type-headline-sm md:type-headline">{copy["services.title"]}</h2>
    <p class="max-w-(--spacing-measure)">{copy["services.note"]}</p>
  </div>

  <RetamaDots />

  <ul class="grid gap-gap lg:grid-cols-4">
    {
      services.map(([name, line, from], index) => (
        <li class:list={["flex flex-col", index === FIELD ? "bg-field text-on-field" : "bg-surface-raised"]}>
          <div class="grid gap-sm p-tile-sm md:p-tile">
            <h3 class="text-balance type-statement-sm md:type-statement">{copy[name]}</h3>
            <p class="max-w-(--spacing-measure)">{copy[line]}</p>
            <p class="type-body-strong">{copy[from]}</p>
          </div>
          <svg class="mt-auto aspect-5/2 w-full lg:hidden" viewBox={slice(index)} aria-hidden="true" data-dots>
            <use href="#retama-dots" />
          </svg>
          <svg
            class="mt-auto hidden aspect-square w-full lg:block"
            viewBox={PARTS[index]}
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
            data-dots
          >
            <use href="#retama-dots" />
          </svg>
        </li>
      ))
    }
  </ul>
</section>
