---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { type Locale, t } from "../../i18n/index";
import { partners } from "../../lib/board";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
// DESIGN.md Imagery: each partner's own photograph, greyscale, once it is in src/assets/team/<key>.jpg; until then the
// slot holds the initials.
const photos = import.meta.glob<ImageMetadata>("../../assets/team/*.jpg", { eager: true, import: "default" });
// The one field tile of the chapter: the partner the client talks to.
const FIELD = "paul";
---

<!-- DESIGN.md Layout, the team: the heading on the ground, then each partner in half a row, the portrait beside the
     text and as tall as it. On phones the portrait comes first. -->
<section id={copy["anchor.team"]} class="grid grid-cols-2 gap-gap lg:grid-cols-12" aria-labelledby="team-title">
  <div class="col-span-2 grid gap-sm px-tile-sm pt-tile-sm pb-lg md:px-tile md:pt-tile lg:col-span-12">
    <h2 id="team-title" class="text-balance type-headline-sm md:type-headline">{copy["team.title"]}</h2>
    <p class="max-w-(--spacing-measure)">{copy["team.lead"]}</p>
  </div>

  {
    partners.map((partner) => {
      const photo = photos[`../../assets/team/${partner.key}.jpg`];
      const field = partner.key === FIELD;
      return (
        <div class="col-span-2 grid gap-gap md:grid-cols-2 lg:col-span-6" data-partner>
          <div class="relative aspect-square bg-surface-raised md:aspect-4/5">
            {photo ? (
              <Picture
                class="absolute inset-0 size-full object-cover"
                src={photo}
                formats={["avif", "webp"]}
                widths={[360, 540, 720]}
                sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
                alt=""
              />
            ) : (
              <div class="absolute inset-0 flex flex-col justify-between p-tile-sm md:p-tile" aria-hidden="true" data-portrait>
                <span class="size-sm bg-primary" />
                <span class="type-display-sm text-on-surface-muted">{partner.initials}</span>
              </div>
            )}
          </div>
          <div class:list={["flex flex-col justify-between gap-lg p-tile-sm md:p-tile", field ? "bg-field text-on-field" : "bg-surface-raised"]}>
            <div class="grid gap-sm">
              <h3 class="text-balance type-statement-sm md:type-statement">{partner.name}</h3>
              <p class:list={["type-small", !field && "text-on-surface-muted"]}>{copy[partner.role]}</p>
              <p class="max-w-(--spacing-measure)">{copy[partner.line]}</p>
            </div>
            {"linkedin" in partner && (
              <a class="feedback w-fit underline hover:decoration-primary" href={partner.linkedin} target="_blank" rel="noopener">
                {copy["team.linkedin"]}
              </a>
            )}
          </div>
        </div>
      );
    })
  }
</section>
