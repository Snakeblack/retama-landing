---
import { type Locale, t } from "../../i18n/index";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
// The gates of .github/workflows/ci.yml and Workers Builds, as they run on every pull request.
const checks = [
  ["frag.checks.lint", "frag.checks.passed"],
  ["frag.checks.unit", "frag.checks.passed"],
  ["frag.checks.design", "frag.checks.passed"],
  ["frag.checks.e2e", "frag.checks.passed"],
  ["frag.checks.preview", "frag.checks.published"],
] as const;
---

<!-- DESIGN.md Imagery: an interface fragment of real work, the quality gates of this site. -->
<figure class="h-full flex flex-col justify-between gap-lg bg-surface-raised p-tile-sm md:p-tile" data-ui>
  <ul class="grid gap-xs">
    {
      checks.map(([name, status]) => (
        <li class="flex items-center justify-between gap-md bg-surface p-md">
          <span class="flex items-center gap-sm">
            <span class="size-sm shrink-0 bg-primary" aria-hidden="true" />
            {copy[name]}
          </span>
          <span class="type-small text-on-surface-muted">{copy[status]}</span>
        </li>
      ))
    }
    <li class="flex flex-wrap items-baseline justify-between gap-md bg-surface p-md">
      <span class="flex items-center gap-sm">
        <span class="size-sm shrink-0 bg-primary" aria-hidden="true"></span>
        {copy["frag.checks.lighthouse"]}
      </span>
      <span class="type-statement-sm tabular-nums md:type-statement">100 · 100 · 100 · 100</span>
    </li>
  </ul>
  <figcaption class="type-small text-on-surface-muted">{copy["frag.checks.caption"]}</figcaption>
</figure>
