---
import { type Locale, t } from "../../i18n/index";
import { contactEmail } from "../../lib/board";
import ReplyFragment from "./ReplyFragment.astro";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
const steps = [
  ["contact.step1", "contact.step1Rest"],
  ["contact.step2", "contact.step2Rest"],
  ["contact.step3", "contact.step3Rest"],
] as const;
---

<!-- Until the form lands (M3) the contact is the address itself, readable and copyable without a mail client.
     Phone order: heading, address, the example reply, then what happens after writing. -->
<section id={copy["anchor.contact"]} class="grid grid-cols-2 gap-gap lg:grid-cols-12" aria-labelledby="contact-title" data-selectable data-chapter="contact">
  <div class="col-span-2 grid content-start gap-lg bg-surface-raised p-tile-sm md:p-tile lg:col-span-6">
    <h2 id="contact-title" class="text-balance type-headline-sm md:type-headline">{copy["contact.title"]}</h2>
    <p class="max-w-(--spacing-measure)">{copy["contact.lead"]}</p>
  </div>

  <div class="col-span-2 flex flex-col justify-end bg-field p-tile-sm text-on-field md:p-tile lg:col-span-6">
    <a class="feedback break-all type-statement-sm underline hover:decoration-primary md:type-statement" href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </div>

  <div class="col-span-2 lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1">
    <ReplyFragment locale={Astro.props.locale} />
  </div>

  <ol class="col-span-2 grid gap-lg bg-surface-raised p-tile-sm md:grid-cols-3 md:p-tile lg:col-span-12">
    {
      steps.map(([lead, rest]) => (
        <li class="flex gap-sm">
          <span class="mt-sm size-sm shrink-0 bg-primary" aria-hidden="true" />
          <span>
            <strong class="type-body-strong">{copy[lead]}</strong> {copy[rest]}
          </span>
        </li>
      ))
    }
  </ol>
</section>
