---
import { type Locale, t } from "../../i18n/index";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
---

<!-- DESIGN.md Imagery: an interface fragment of real work, the decision record behind the hero scene. -->
<figure class="h-full flex flex-col justify-between gap-md bg-surface-raised p-tile-sm md:p-tile" data-ui>
  <div class="grid gap-sm bg-surface p-md">
    <p class="flex flex-wrap items-center justify-between gap-x-sm type-small text-on-surface-muted">
      <span class="whitespace-nowrap">ADR 0004</span>
      <span class="flex items-center gap-xs text-on-surface">
        <span class="size-sm bg-primary" aria-hidden="true"></span>
        {copy["frag.adr.status"]}
      </span>
    </p>
    <p class="type-body-strong">{copy["frag.adr.title"]}</p>
  </div>
  <figcaption class="type-small text-on-surface-muted">{copy["frag.adr.caption"]}</figcaption>
</figure>
