---
import { type Locale, t } from "../../i18n/index";

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale);
// Retama has no client work to show yet: this panel is an example and says so on its face.
const routes = [
  ["R-12", 14, "frag.routes.onRoute", false],
  ["R-07", 9, "frag.routes.loading", false],
  ["R-21", 11, "frag.routes.incident", true],
] as const;
---

<figure class="h-full flex flex-col gap-md bg-surface-raised p-tile-sm md:p-tile" data-ui>
  <figcaption class="flex items-center justify-between gap-md type-small text-on-surface-muted">
    {copy["frag.routes.caption"]}
    <span class="bg-field px-sm text-on-field" data-example>{copy["frag.example"]}</span>
  </figcaption>
  <table class="w-full border-separate border-spacing-y-(--spacing-xs) text-left tabular-nums">
    <thead class="type-small text-on-surface-muted">
      <tr>
        <th class="px-md type-small" scope="col">{copy["frag.routes.route"]}</th>
        <th class="px-md type-small" scope="col">{copy["frag.routes.stops"]}</th>
        <th class="px-md type-small" scope="col">{copy["frag.routes.status"]}</th>
      </tr>
    </thead>
    <tbody>
      {
        routes.map(([route, stops, status, alert]) => (
          <tr class="bg-surface">
            <td class="p-md">{route}</td>
            <td class="p-md">{stops}</td>
            <td class="p-md">
              <span class="flex items-center gap-sm">
                {alert ? (
                  <span class="size-sm shrink-0 bg-primary" aria-hidden="true" />
                ) : (
                  <span class="size-sm shrink-0 bg-on-surface-muted" aria-hidden="true" />
                )}
                {copy[status]}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>
