---
import { type Locale, t } from "../i18n/index";
import Base from "../layouts/Base.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<Base locale={locale} title={copy["meta.title"]} description={copy["meta.description"]}>
  <section class="px-margin pt-xl pb-section">
    <div class="max-w-(--spacing-measure) bg-surface-raised p-tile-sm md:p-tile">
      <h1 class="type-headline-sm mb-lg text-balance md:type-headline">{copy["home.title"]}</h1>
      <p class="type-statement-sm md:type-statement">{copy["home.lead"]}</p>
    </div>
  </section>
</Base>
