---
import { PUBLIC_BOOKING } from "astro:env/client";
import { type Locale, t } from "../i18n/index";
import Base from "../layouts/Base.astro";
import { bookingUrl } from "../lib/board";
import { bookingFrameDirective } from "../lib/booking";
import ChapterIndex from "./ChapterIndex.astro";
import Contact from "./board/Contact.astro";
import Footer from "./board/Footer.astro";
import Hero from "./board/Hero.astro";
import Method from "./board/Method.astro";
import Questions from "./board/Questions.astro";
import Sectors from "./board/Sectors.astro";
import Services from "./board/Services.astro";
import Team from "./board/Team.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const chapters = (
  [
    ["anchor.services", "nav.services", "services.title"],
    ["anchor.sectors", "nav.sectors", "sectors.title"],
    ["anchor.method", "nav.method", "method.title"],
    ["anchor.team", "nav.team", "team.title"],
    ["anchor.questions", "nav.questions", "faq.title"],
  ] as const
).map(([anchor, name, title]) => ({ anchor: copy[anchor], name: copy[name], title: copy[title] }));

// The call booking of the contact chapter waits for its flag (astro.config.mjs): off, there is no action, no tile and
// no Cal.com in the CSP. The directive goes here, before Base renders the head; from Contact.astro it comes too late.
if (PUBLIC_BOOKING) Astro.csp?.insertDirective(bookingFrameDirective(bookingUrl));
---

<!-- DESIGN.md Layout: the home is a sequence of chapters, 128px apart, more than any gap inside one. -->
<Base locale={locale} title={copy["meta.title"]} description={copy["meta.description"]} questions scene>
  <!-- From md the chapters lead the header's links; on phones the chapter index holds them. -->
  <Fragment slot="nav">
    {
      chapters.map(({ anchor, name }) => (
        <li>
          <a class="feedback flex min-h-(--spacing-touch) items-center type-small text-on-surface hover:text-primary" href={`#${anchor}`}>
            {name}
          </a>
        </li>
      ))
    }
  </Fragment>
  <ChapterIndex slot="menu" locale={locale} chapters={chapters} />
  <!-- DESIGN.md Layout: the one action stays at hand, fixed to the lower right corner; global.css hides it while the
       first chapter or the contact chapter is on screen. -->
  <a slot="action" class="feedback fixed right-margin bottom-margin z-10 flex min-h-(--spacing-touch) items-center bg-primary px-lg type-label text-on-primary hover:bg-field hover:text-on-field" href={`#${copy["anchor.contact"]}`} data-talk>
    {copy["nav.talk"]}
  </a>
  <Hero locale={locale} />
  <!-- DESIGN.md Elevation & Depth: the grounds of the chapters after the first carry the grain (global.css). -->
  <div class="grid gap-section px-margin" data-grounds>
    <Services locale={locale} />
    <Sectors locale={locale} />
    <Method locale={locale} />
    <Team locale={locale} />
    <Questions locale={locale} />
    <Contact locale={locale} />
  </div>
  <Footer slot="footer" locale={locale} />
</Base>

<!-- One bundle for the page: a second module script in the head costs Lighthouse a round trip before the first
     paint (scenario:perf-mobile). The motion layer comes after the first paint, below. -->
<script>
  import "../scripts/booking";
  import "../scripts/contact";
  import "../scripts/scene";

  // scenario:perf-mobile: GSAP is most of the page's JavaScript, and a script asked for at high priority that is in
  // before the first contentful paint counts in the first and largest paints Lighthouse simulates; a frame or an idle
  // moment after the load can still come before that paint. So the motion layer is asked for once the page has loaded
  // and painted, while what it moves is below the first screen (motion.ts). A browser without paint timing never
  // asks for it and keeps the board as the HTML has it.
  addEventListener(
    "load",
    () =>
      new PerformanceObserver((entries, observer) => {
        if (entries.getEntriesByName("first-contentful-paint").length === 0) return;
        observer.disconnect();
        void import("../scripts/motion");
      }).observe({ type: "paint", buffered: true }),
    { once: true },
  );
</script>
