---
import { type Locale, t } from "../i18n/index";
import Base from "../layouts/Base.astro";
import ChapterIndex from "./ChapterIndex.astro";
import Contact from "./board/Contact.astro";
import Footer from "./board/Footer.astro";
import Hero from "./board/Hero.astro";
import Method from "./board/Method.astro";
import Sectors from "./board/Sectors.astro";
import Services from "./board/Services.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const chapters = (
  [
    ["anchor.services", "nav.services", "services.title"],
    ["anchor.sectors", "nav.sectors", "sectors.title"],
    ["anchor.method", "nav.method", "method.title"],
  ] as const
).map(([anchor, name, title]) => ({ anchor: copy[anchor], name: copy[name], title: copy[title] }));
---

<!-- DESIGN.md Layout: the home is a sequence of chapters, 128px apart, more than any gap inside one. -->
<Base locale={locale} title={copy["meta.title"]} description={copy["meta.description"]}>
  <!-- From md the links sit in the header; on phones the chapter index holds them. -->
  <nav slot="nav" class="hidden md:block" aria-label={copy["nav.label"]}>
    <ul class="flex gap-lg">
      {
        chapters.map(({ anchor, name }) => (
          <li>
            <a class="feedback flex min-h-(--spacing-touch) items-center type-small text-on-surface hover:text-primary" href={`#${anchor}`}>
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ChapterIndex slot="menu" locale={locale} chapters={chapters} />
  <!-- DESIGN.md Layout: the one action stays at hand, fixed to the lower right corner; global.css hides it while the
       first chapter or the contact chapter is on screen. -->
  <a slot="action" class="feedback fixed right-margin bottom-margin z-10 flex min-h-(--spacing-touch) items-center bg-primary px-lg type-label text-on-primary hover:bg-field hover:text-on-field" href={`#${copy["anchor.contact"]}`} data-talk>
    {copy["nav.talk"]}
  </a>
  <Hero locale={locale} />
  <!-- DESIGN.md Elevation & Depth: the grounds of the chapters after the first carry the grain (global.css). -->
  <div class="grid gap-section px-margin" data-grounds>
    <Services locale={locale} />
    <Sectors locale={locale} />
    <Method locale={locale} />
    <Contact locale={locale} />
  </div>
  <Footer slot="footer" locale={locale} />
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/scene";
</script>
