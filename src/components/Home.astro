---
import { type Locale, t } from "../i18n/index";
import Base from "../layouts/Base.astro";
import Contact from "./board/Contact.astro";
import Footer from "./board/Footer.astro";
import Hero from "./board/Hero.astro";
import Method from "./board/Method.astro";
import Sectors from "./board/Sectors.astro";
import Services from "./board/Services.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const sections = [
  ["anchor.services", "nav.services"],
  ["anchor.sectors", "nav.sectors"],
  ["anchor.method", "nav.method"],
] as const;
---

<!-- DESIGN.md Layout: the home is a sequence of chapters, 128px apart, more than any gap inside one. -->
<Base locale={locale} title={copy["meta.title"]} description={copy["meta.description"]}>
  <!-- On phones the links take their own row under the wordmark and the language switch. -->
  <nav slot="nav" class="order-last basis-full md:order-none md:mr-auto md:basis-auto" aria-label={copy["nav.label"]}>
    <ul class="flex gap-lg">
      {
        sections.map(([anchor, label]) => (
          <li>
            <a class="feedback type-small text-on-surface hover:text-primary" href={`#${copy[anchor]}`}>
              {copy[label]}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <!-- DESIGN.md Layout: the one action stays at hand, fixed to the lower right corner; global.css hides it while the
       first chapter or the contact chapter is on screen. -->
  <a slot="nav" class="feedback fixed right-margin bottom-margin z-10 flex min-h-(--spacing-touch) items-center bg-primary px-lg type-label text-on-primary hover:bg-field hover:text-on-field" href={`#${copy["anchor.contact"]}`} data-talk>
    {copy["nav.talk"]}
  </a>
  <Hero locale={locale} />
  <div class="grid gap-section px-margin">
    <Services locale={locale} />
    <Sectors locale={locale} />
    <Method locale={locale} />
    <Contact locale={locale} />
  </div>
  <Footer slot="footer" locale={locale} />
</Base>

<script>
  import "../scripts/motion";
  import "../scripts/scene";
</script>
