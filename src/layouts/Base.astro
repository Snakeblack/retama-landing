---
import { Font } from "astro:assets";
import { defaultLocale, type Locale, localizedPath, locales, pathWithoutLocale, t } from "../i18n/index";
import { alternates, canonicalUrl } from "../lib/seo";
import "../styles/global.css";
import theme from "../styles/theme.css?raw";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const page = pathWithoutLocale(Astro.url.pathname);
const other = locales.find((candidate) => candidate !== locale) ?? defaultLocale;
// The browser chrome takes the page ground from the DESIGN.md tokens.
const themeColor = theme.match(/--color-surface:\s*([^;]+);/)?.[1];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-stack-sans-headline" preload />
    <Font cssVariable="--font-stack-sans-text" preload />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl(site, Astro.url.pathname)} />
          {alternates(site, Astro.url.pathname).map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={themeColor} />
  </head>
  <body>
    <div class="h-bar bg-primary" aria-hidden="true"></div>
    <!-- The header text lines up with the text inside the tiles: page margin plus tile padding. A page may add its
         navigation between the wordmark and the language switch (slot "nav"). -->
    <header class="px-margin py-md">
      <div class="flex flex-wrap items-center justify-between gap-x-lg gap-y-sm px-tile-sm md:px-tile">
        <a class="feedback type-wordmark text-on-surface hover:text-primary" href={localizedPath(locale, "/")}>
          <Wordmark class="block" />
          <span class="sr-only">Retama</span>
        </a>
        <slot name="nav" />
        <a class="lang-switch feedback type-small text-on-surface hover:text-primary" href={localizedPath(other, page)} hreflang={other} lang={other}>
          {t(locale)["nav.switchLabel"]}
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
