---
import { Font } from "astro:assets";
import { type Locale, localizedPath } from "../i18n/index";
import { alternates, canonicalUrl } from "../lib/seo";
import "../styles/global.css";
import theme from "../styles/theme.css?raw";
import LangSwitch from "../components/LangSwitch.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
// The browser chrome takes the page ground from the DESIGN.md tokens.
const themeColor = theme.match(/--color-surface:\s*([^;]+);/)?.[1];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-stack-sans-headline" preload />
    <Font cssVariable="--font-stack-sans-text" preload />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl(site, Astro.url.pathname)} />
          {alternates(site, Astro.url.pathname).map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={themeColor} />
  </head>
  <body>
    <!-- DESIGN.md Layout: the header floats over the page, the first chapter's scene included; header.ts sends it away
         while the page scrolls down and back as soon as it scrolls up. Its text lines up with the text inside the tiles:
         page margin plus tile padding. A page may add its links (slot "nav", from md), its chapter index (slot "menu",
         on phones) and its fixed action (slot "action", outside the bar that moves). -->
    <header>
      <div class="fixed inset-x-0 top-0 z-20 bg-surface" data-header-bar>
        <div class="h-bar bg-primary" aria-hidden="true"></div>
        <div class="px-margin py-md">
          <div class="flex items-center gap-md px-tile-sm md:gap-lg md:px-tile">
            <a class="feedback type-wordmark text-on-surface hover:text-primary" href={localizedPath(locale, "/")}>
              <Wordmark class="block" />
              <span class="sr-only">Retama</span>
            </a>
            <slot name="nav" />
            <LangSwitch class="ml-auto" locale={locale} primary />
            <slot name="menu" />
          </div>
        </div>
      </div>
      <slot name="action" />
    </header>
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import "../scripts/header";
    </script>
  </body>
</html>
