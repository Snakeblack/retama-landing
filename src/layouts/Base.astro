---
import { Font } from "astro:assets";
import { PUBLIC_CF_ANALYTICS_TOKEN } from "astro:env/client";
import { type Locale, localizedPath, t } from "../i18n/index";
import { analyticsToken, beaconCsp } from "../lib/analytics";
import { type Article, alternates, type Crumb, canonicalUrl, jsonLd, openGraph, structuredData } from "../lib/seo";
import { type ServiceId, serviceImagePath } from "../lib/services";
import "../styles/global.css";
import theme from "../styles/theme.css?raw";
import Analytics from "../components/Analytics.astro";
import LangSwitch from "../components/LangSwitch.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  /** The page's breadcrumb after the home page of its language, for the JSON-LD. */
  trail?: Crumb[];
  /** The page holds the questions chapter, which the JSON-LD repeats as its FAQPage. */
  questions?: boolean;
  /** The page's path in every language when it is translated, like an article; otherwise it is the same path. */
  paths?: Record<Locale, string>;
  /** The page is an article of the blog: Open Graph and the JSON-LD describe it. */
  article?: Article;
  /** The page is a service's page: it has its own Open Graph image, and the JSON-LD describes the service. */
  service?: ServiceId;
  /** The page is the blog's index, which its link in the header marks. */
  blog?: boolean;
  /** The RSS of the page's blog, which the head announces (the blog's index and its articles). */
  feed?: string;
}

const {
  locale,
  title,
  description,
  noindex = false,
  trail,
  questions = false,
  paths,
  article,
  service,
  blog = false,
  feed,
} = Astro.props;
const copy = t(locale);
const image = service && {
  path: serviceImagePath(locale, service),
  alt: `${copy[`services.${service}`]}, ${copy["service.imageAlt"]}`,
};
// On a page with a chapter index (the home), the links leave the bar on phones for the index, which holds them too.
const withMenu = Astro.slots.has("menu");
const site = Astro.site ?? new URL(Astro.url.origin);
// The browser chrome takes the page ground from the DESIGN.md tokens.
const themeColor = theme.match(/--color-surface:\s*([^;]+);/)?.[1];
// Cloudflare Web Analytics waits for the site's token (astro.config.mjs): without it there is no beacon and the CSP
// admits nothing more. With it, every page measures, Previews included: Cloudflare drops hostnames outside retama.dev.
const analytics = analyticsToken(PUBLIC_CF_ANALYTICS_TOKEN) !== null;
if (analytics) {
  const csp = beaconCsp();
  Astro.csp?.insertScriptResource(csp.script);
  Astro.csp?.insertDirective(csp.connect);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-stack-sans-headline" preload />
    <Font cssVariable="--font-stack-sans-text" preload />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonicalUrl(site, Astro.url.pathname)} />
          {alternates(site, Astro.url.pathname, paths).map((alt) => (
            <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
          ))}
          {openGraph(site, locale, Astro.url.pathname, title, description, article, image).map(([property, content]) => (
            <meta property={property} content={content} />
          ))}
          <meta name="twitter:card" content="summary_large_image" />
          {/* A data block, never run: the CSP's script-src does not apply to it (ADR 0006). */}
          <script type="application/ld+json" set:html={jsonLd(structuredData(site, locale, trail, questions, article, service))} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    {feed && <link rel="alternate" type="application/rss+xml" title={copy["blog.metaTitle"]} href={feed} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={themeColor} />
  </head>
  <body>
    <!-- DESIGN.md Layout: the header floats over the page, the first chapter's scene included; header.ts sends it away
         while the page scrolls down and back as soon as it scrolls up. Its text lines up with the text inside the tiles:
         page margin plus tile padding. The wordmark stands alone on the left and the rest gathers on the right: the
         links, which a page may lead with its own (slot "nav", list items) before the blog's, its chapter index (slot
         "menu", which takes the links' place on phones) and its fixed action (slot "action", outside the bar that
         moves). -->
    <header>
      <div class="fixed inset-x-0 top-0 z-20 bg-surface" data-header-bar>
        <div class="h-bar bg-primary" aria-hidden="true"></div>
        <div class="px-margin py-md">
          <div class="flex items-center gap-md px-tile-sm md:gap-lg md:px-tile">
            <a class="feedback mr-auto type-wordmark text-on-surface hover:text-primary" href={localizedPath(locale, "/")}>
              <Wordmark class="block" />
              <span class="sr-only">Retama</span>
            </a>
            <nav class:list={["md:block", withMenu ? "hidden" : "block"]} aria-label={copy["nav.label"]}>
              <ul class="flex gap-lg">
                <slot name="nav" />
                <li>
                  <a
                    class="feedback flex min-h-(--spacing-touch) items-center type-small text-on-surface hover:text-primary"
                    href={localizedPath(locale, "/blog/")}
                    aria-current={blog ? "page" : undefined}
                  >
                    {copy["nav.blog"]}
                  </a>
                </li>
              </ul>
            </nav>
            <LangSwitch locale={locale} paths={paths} primary />
            <slot name="menu" />
          </div>
        </div>
      </div>
      <slot name="action" />
    </header>
    <main>
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // The error reports first, so they hear the errors of the scripts after them (ADR 0011).
      import "../scripts/report";
      import "../scripts/header";
    </script>
    {analytics && <Analytics />}
  </body>
</html>
