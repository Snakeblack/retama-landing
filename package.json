{
  "name": "retama-landing",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "pnpm build && pnpm serve:dist",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve:dist": "wrangler dev -c dist/server/wrangler.json",
    "design:theme": "node scripts/design-check.mjs --write",
    "design:lint": "node scripts/design-check.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/stack-sans-headline": "5.3.0",
    "@fontsource-variable/stack-sans-text": "5.3.0",
    "@fontsource/stack-sans-headline": "5.3.0",
    "@google/design.md": "0.4.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "satori": "0.33.5",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  }
}
