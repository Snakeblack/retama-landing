{
  "name": "retama-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "pnpm build && pnpm serve:dist",
    "lint": "biome check . && eslint .",
    "format": "biome check --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve:dist": "wrangler dev -c dist/client/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.1",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.150.0"
  }
}
